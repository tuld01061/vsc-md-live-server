{
  "name": "md-live-server",
  "displayName": "Markdown Live Server",
  "description": "Preview Markdown, Mermaid diagrams, and static web files with a local live-reload server.",
  "version": "0.2.3",
  "publisher": "tuld01061",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:md-live-server.start",
    "onCommand:md-live-server.stop",
    "onCommand:md-live-server.toggle"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "md-live-server.start",
        "title": "Start Markdown Live Server",
        "category": "Markdown Live Server"
      },
      {
        "command": "md-live-server.stop",
        "title": "Stop Markdown Live Server",
        "category": "Markdown Live Server"
      },
      {
        "command": "md-live-server.toggle",
        "title": "Toggle Markdown Live Server",
        "category": "Markdown Live Server"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "md-live-server.start",
          "when": "resourceScheme == file",
          "group": "navigation@100"
        }
      ],
      "explorer/context": [
        {
          "command": "md-live-server.start",
          "when": "resourceScheme == file",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Live Server",
      "properties": {
        "mdLiveServer.port": {
          "type": "number",
          "default": 4400,
          "minimum": 1,
          "maximum": 65535,
          "description": "Preferred port for the live server. If it is busy, the next available port (4401, 4402, …) is used."
        },
        "mdLiveServer.siteMenu.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable site menu sidebar"
        },
        "mdLiveServer.siteMenu.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "*"
          ],
          "description": "Patterns for files to include in menu"
        },
        "mdLiveServer.siteMenu.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".*",
            "node_modules"
          ],
          "description": "Patterns for files to exclude from menu"
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run clean && tsc -p ./ --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js && esbuild src/browser/editor.ts --bundle --format=iife --platform=browser --minify --outfile=out/editor.js",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish": "vsce publish",
    "lint:package": "vsce ls --tree",
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.18.3",
    "markdown-it": "^14.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.1",
    "@types/express": "^4.17.21",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.11.24",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.10",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.28.0",
    "typescript": "^5.4.2",
    "vitest": "^4.1.6"
  },
  "license": "MIT",
  "author": "Tu Luu",
  "homepage": "https://github.com/tuld01061/vsc-md-live-server#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuld01061/vsc-md-live-server.git"
  },
  "bugs": {
    "url": "https://github.com/tuld01061/vsc-md-live-server/issues"
  },
  "icon": "images/icon.png",
  "keywords": [
    "markdown",
    "live server",
    "preview",
    "mermaid",
    "reload",
    "static server"
  ],
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "qna": "marketplace"
}
